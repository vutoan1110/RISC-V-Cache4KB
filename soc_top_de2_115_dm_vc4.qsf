set_global_assignment -name SEARCH_PATH hdl
set_global_assignment -name FAMILY "Cyclone IV E"
# Fitter seed, pinned HERE in the revision .qsf rather than only in the sourced
# quartus/soc_core_common.qsf. Two things were measured on 2026-09-11:
#  1. a SEED assignment arriving through `source` does not take effect (other
#     assignments from the same file, e.g. NUM_PARALLEL_PROCESSORS, do);
#  2. `quartus_fit --seed=N` WRITES N back into this file, which is how the
#     stale `SEED 5` lines got here in the first place.
# So after any seed sweep, check this line before quoting a build as canonical.
set_global_assignment -name SEED 2
set_global_assignment -name SDC_FILE quartus/soc_core_50mhz.sdc
