set_global_assignment -name TOP_LEVEL_ENTITY de2_115_top
source quartus/soc_core_common.qsf
source quartus/de2_115/de2_115_common.qsf

# Fitter seed, pinned HERE in the revision .qsf rather than only in the sourced
# quartus/soc_core_common.qsf. Two things were measured on 2026-09-11:
#  1. a SEED assignment arriving through `source` does not take effect (other
#     assignments from the same file, e.g. NUM_PARALLEL_PROCESSORS, do);
#  2. `quartus_fit --seed=N` WRITES N back into this file, which is how the
#     stale `SEED 5` lines got here in the first place.
# So after any seed sweep, check this line before quoting a build as canonical.
set_global_assignment -name SEED 2

set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_de2_115_dm
set_parameter -name CACHE_CONFIG 0
set_parameter -name VICTIM_ENTRIES 4
set_parameter -name ICACHE_LINE_COUNT 64
set_parameter -name DCACHE_LINE_COUNT 64
set_parameter -name BRANCH_PREDICT_ENABLE 1
set_parameter -name BHT_ENTRIES 256

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
