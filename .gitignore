# Research workspace: sources, scripts, configs and the English documentation only.
# Everything generated stays out: PD runs (~150 GB), Quartus databases, simulator libraries, waveforms,
# results. Whitelist: ignore every top-level entry, then re-include the source trees.
# Working notes (design journal, procedures, workspace map, state file) and the Vietnamese report page are kept
# on the workstation only.
/*
!/.gitignore
!/README.md
!/RESULTS.md
!/REVIEW_RESPONSE.md
!/*.qsf
!/*.qpf
# Quartus revisions written by scripts/run_fpga_points.py before every fit
/point_*.qsf
/point_*.qpf
!/hdl/
!/sw/
!/fw/
!/tb/
!/verification/
!/scripts/
!/quartus/
!/asic/
!/results/
# metric firmware outside the RTL manifest roots (interrupt latency / context switch, 2026-10-02)
!/sw_metrics/
/sw_metrics/**/*.hex
/sw_metrics/**/*.bin
/sw_metrics/**/*.dump
/sw_metrics/**/*.map
# ACT4: keep the per-test logs, the summaries and the signatures' SHA-256 list (review A7); not the
# build tree, the images or the signature files themselves (6.6 MB per pass, pass 1 = pass 2 byte for byte)
/verification/results/act4/work/
/verification/results/act4/images/
/verification/results/act4/dut_p*/signatures/

# results/: the summary documents cited by README.md / RESULTS.md / REVIEW_RESPONSE.md only; measurement outputs,
# receipts, working notes and status reports stay on the workstation
/results/*
!/results/a1_le_breakdown_r16.md
!/results/a1_le_breakdown_rfbht.md
!/results/asic_compare_dm_r14.md
!/results/asic_compare_dm_sa2_20261009.md
!/results/extensions_vs_published_1kib_20261014.md
!/results/fpga_common_seeds_continued_20261009_ppa.md
!/results/unified_metrics.md
!/results/m2/
/results/m2/*
!/results/m2/M1_M2_REPORT.md
!/results/m2/M1_M2_analysis.md
# small data files cited by those documents
!/results/rtl_manifest.json
!/results/fpga_points_r16_p1.csv
!/results/fpga_points_r16_p2.csv
!/results/fullchain_r16.log
!/results/le_r16_compare.log
!/results/m2/sweep_p1.csv
!/results/m2/sweep_p2.csv
!/results/m2/sweep_fast_p1.csv
!/results/m2/sweep_fast_p2.csv

# asic/: flow sources and configs, not runs or tool outputs
/asic/*
!/asic/*.md
/asic/pd_log.md
!/asic/*.sh
!/asic/*.py
!/asic/evidence/
/asic/evidence/*
!/asic/evidence/*.md
!/asic/evidence/magicsafe_*_proof.log
!/asic/openlane-local/
!/asic/gls/
!/asic/sta_query/
!/asic/snapshots/
# frozen RTL snapshots that no tracked configuration reads any more stay local
/asic/snapshots/rtl_r10f1/
/asic/snapshots/rtl_r10f2/
/asic/snapshots/rtl_r13a/
/asic/snapshots/rtl_r13b/
!/asic/soc_dm_4kb/
!/asic/pd_exp/
!/asic/equiv/
/asic/soc_dm_4kb/runs/
/asic/soc_dm_4kb/macros/
# SA2 / DM_VC4 ASIC builds: the SRAM bank wrapper and the two design dirs, not their runs
# or their copies of the macro models
!/asic/dse_sram/
!/asic/soc_sa2_4kb/
!/asic/soc_vc4_4kb/
/asic/soc_sa2_4kb/runs/
/asic/soc_vc4_4kb/runs/
/asic/soc_sa2_4kb/macros/
/asic/soc_vc4_4kb/macros/
# floorplan analysis tools and their screening results (2026-10-03)
!/asic/fp_tools/
!/asic/fp_explore/
/asic/fp_explore/*
!/asic/fp_explore/*.md
!/asic/fp_explore/*.txt
# pd_exp/ and equiv/ hold experiment outputs next to their scripts: keep the scripts and cut lists only
/asic/pd_exp/**
!/asic/pd_exp/**/
!/asic/pd_exp/**/*.py
!/asic/pd_exp/**/*.tcl
!/asic/pd_exp/**/*.sh
!/asic/pd_exp/**/*.txt
/asic/equiv/**
!/asic/equiv/**/
!/asic/equiv/**/*.py
!/asic/equiv/**/*.ps1
!/asic/equiv/**/*.sh
!/asic/equiv/**/*.ys
!/asic/equiv/**/*.tcl

# build products, simulator output and caches anywhere
__pycache__/
*.pyc
/sw/benchmark.*
/sw/benchmark_rv32.hex
/sw/coremark/*.elf
/sw/coremark/*.bin
/sw/coremark/*.dump
/sw/coremark/*.map
*.vcd
*.wlf
*.vstf
transcript
tr_db.log
work/
work_*/
/verification/uvm/out/

# data dumps and third-party models that are not project code
/asic/gls/lib/
/asic/sta_query/*.txt
/asic/sta_query/*.out
/asic/pd_exp/rc_corr/est*.txt
/asic/pd_exp/rc_corr/spef*.txt
*.elf

# generated PD databases / parasitics / netlists / screening folders inside the design dirs (2026-10-15, before the
# first push to the private GitHub repo): never in git
/asic/soc_*_4kb/**/*.odb
/asic/soc_*_4kb/**/*.def
/asic/soc_*_4kb/**/*.spef
/asic/soc_*_4kb/**/*.gds
/asic/soc_*_4kb/**/*.nl.v
/asic/soc_*_4kb/**/*.pnl.v
/asic/soc_*_4kb/**/*.sdf
/asic/soc_*_4kb/**/*.log
/asic/soc_*_4kb/screen_*/
/asic/soc_*_4kb/diag_*/
/scripts/maintenance/workspace_inventory.py
