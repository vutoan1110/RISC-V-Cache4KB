# Research workspace (local git since 2026-09-30): sources, scripts, configs and documents only.
# Everything generated stays out: PD runs (~150 GB), Quartus databases, simulator libraries, waveforms,
# results. Whitelist: ignore every top-level entry, then re-include the source trees.
/*
!/.gitignore
!/*.md
!/*.qsf
!/*.qpf
# Quartus revisions written by scripts/run_fpga_points.py before every fit
/point_*.qsf
/point_*.qpf
!/hdl/
!/sw/
!/fw/
!/tb/
!/verification/
!/scripts/
!/quartus/
!/asic/
!/results/
# metric firmware outside the RTL manifest roots (interrupt latency / context switch, 2026-10-02)
!/sw_metrics/
/sw_metrics/**/*.hex
/sw_metrics/**/*.bin
/sw_metrics/**/*.dump
/sw_metrics/**/*.map
# ACT4: keep the per-test logs, the summaries and the signatures' SHA-256 list (review A7); not the
# build tree, the images or the signature files themselves (6.6 MB per pass, pass 1 = pass 2 byte for byte)
/verification/results/act4/work/
/verification/results/act4/images/
/verification/results/act4/dut_p*/signatures/

# results/: documents only
/results/*
!/results/*.md
!/results/cleanup_deleted.txt

# asic/: flow sources and configs, not runs or tool outputs
/asic/*
!/asic/*.md
!/asic/*.sh
!/asic/*.py
!/asic/evidence/
/asic/evidence/*
!/asic/evidence/*.md
!/asic/evidence/magicsafe_*_proof.log
!/asic/openlane-local/
!/asic/gls/
!/asic/sta_query/
!/asic/snapshots/
!/asic/soc_dm_4kb/
!/asic/pd_exp/
!/asic/equiv/
/asic/soc_dm_4kb/runs/
/asic/soc_dm_4kb/macros/
# SA2 / DM_VC4 ASIC builds: the SRAM bank wrapper and the two design dirs, not their runs
# or their copies of the macro models
!/asic/dse_sram/
!/asic/soc_sa2_4kb/
!/asic/soc_vc4_4kb/
/asic/soc_sa2_4kb/runs/
/asic/soc_vc4_4kb/runs/
/asic/soc_sa2_4kb/macros/
/asic/soc_vc4_4kb/macros/
# floorplan analysis tools and their screening results (2026-10-03)
!/asic/fp_tools/
!/asic/fp_explore/
/asic/fp_explore/*
!/asic/fp_explore/*.md
!/asic/fp_explore/*.txt
# pd_exp/ and equiv/ hold experiment outputs next to their scripts: keep the scripts and cut lists only
/asic/pd_exp/**
!/asic/pd_exp/**/
!/asic/pd_exp/**/*.py
!/asic/pd_exp/**/*.tcl
!/asic/pd_exp/**/*.sh
!/asic/pd_exp/**/*.txt
/asic/equiv/**
!/asic/equiv/**/
!/asic/equiv/**/*.py
!/asic/equiv/**/*.ps1
!/asic/equiv/**/*.sh
!/asic/equiv/**/*.ys
!/asic/equiv/**/*.tcl

# build products, simulator output and caches anywhere
__pycache__/
*.pyc
/sw/benchmark.*
/sw/benchmark_rv32.hex
/sw/coremark/*.elf
/sw/coremark/*.bin
/sw/coremark/*.dump
/sw/coremark/*.map
*.vcd
*.wlf
*.vstf
transcript
tr_db.log
work/
work_*/
/verification/uvm/out/

# data dumps and third-party models that are not project code
/asic/gls/lib/
/asic/sta_query/*.txt
/asic/sta_query/*.out
/asic/pd_exp/rc_corr/est*.txt
/asic/pd_exp/rc_corr/spef*.txt
*.elf
