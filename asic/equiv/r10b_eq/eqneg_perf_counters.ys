hierarchy -top perf_counters
proc
flatten
rename perf_counters perf_counters_gold
design -stash gold
read_verilog -sv -D__openlane__ perf_counters_mutant.v 
hierarchy -top perf_counters
proc
flatten
rename perf_counters perf_counters_gate
design -stash gate
