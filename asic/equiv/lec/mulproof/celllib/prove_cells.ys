design -copy-from g -as gold_alu64 gold_alu64
design -copy-from t -as gate_alu64 gate_alu64
miter -equiv -flatten -make_assert gold_alu64 gate_alu64 miter_alu64
hierarchy -top miter_alu64
sat -verify -prove-asserts miter_alu64
