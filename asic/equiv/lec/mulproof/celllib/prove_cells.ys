design -copy-from g -as gold_and64 gold_and64
design -copy-from t -as gate_and64 gate_and64
miter -equiv -flatten -make_assert gold_and64 gate_and64 miter_and64
hierarchy -top miter_and64
sat -verify -prove-asserts miter_and64
