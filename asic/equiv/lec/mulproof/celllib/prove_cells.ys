# FLOW_JOURNAL Incident 89: each cell configuration == its techmap (miter + SAT proof); run by run_celllib.sh
design -reset
read_rtlil cells.il
hierarchy -top fa64
rename fa64 gold_fa64
design -stash g
read_rtlil cells.il
hierarchy -top fa64
techmap
opt_clean
rename fa64 gate_fa64
design -stash t
design -copy-from g -as gold_fa64 gold_fa64
design -copy-from t -as gate_fa64 gate_fa64
miter -equiv -flatten -make_assert gold_fa64 gate_fa64 miter_fa64
hierarchy -top miter_fa64
sat -verify -prove-asserts miter_fa64
design -reset
read_rtlil cells.il
hierarchy -top fa63
rename fa63 gold_fa63
design -stash g
read_rtlil cells.il
hierarchy -top fa63
techmap
opt_clean
rename fa63 gate_fa63
design -stash t
design -copy-from g -as gold_fa63 gold_fa63
design -copy-from t -as gate_fa63 gate_fa63
miter -equiv -flatten -make_assert gold_fa63 gate_fa63 miter_fa63
hierarchy -top miter_fa63
sat -verify -prove-asserts miter_fa63
