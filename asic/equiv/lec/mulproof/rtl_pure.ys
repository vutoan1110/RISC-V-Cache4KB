# FLOW_JOURNAL Incident 89: the RTL-gold multiplier (gold_pre.il = RTL + proved fsm), in its design context (light extraction).
# Flops and SRAM macros are removed (the multiplier cone is combinational from the operand nets and the
# extraction stops there); the operand and product nets are exposed for mulsub.py extract.
read_ilang ../../sec/gold_pre.il
hierarchy -top soc_asic_top
delete t:$*dff* t:$ff t:$_DFF* t:$_SDFF* t:$_ALDFF* t:$_DLATCH* t:sky130_sram_*
expose w:u_soc.u_core.u_pipeline.datapath.alu.mul_a w:u_soc.u_core.u_pipeline.datapath.alu.mul_b w:u_soc.u_core.u_pipeline.datapath.alu.product
setundef -undriven -zero
techmap
opt_clean
aigmap
opt_clean
write_aiger -symbols rtl_ctx.aig
