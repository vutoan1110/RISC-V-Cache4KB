# the synthesis-style multiplier: wreduce + alumacc ($mul -> $macc) + techmap (maccmap CSA tree),
# the steps OpenLane's synthesis applies to this cell (06-yosys-synthesis log: wreduce "Removed top 2
# bits (of 66) from port Y of cell ...alu.$mul", alumacc "creating $macc model")
read_verilog mul33.v
hierarchy -top mul33
proc; opt_clean
wreduce t:$mul
alumacc t:$mul
opt_clean
techmap; opt_clean; aigmap; opt_clean
write_aiger -symbols mulB.aig
