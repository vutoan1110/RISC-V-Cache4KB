# EQY script for soc_asic_top, corrected.
#
# OpenLane's generated script puts `read_liberty -setattr blackbox` in the
# SHARED [script] section, so all 428 sky130_fd_sc_hd cell models become
# blackbox modules on BOTH sides. On the gate side formal_pdk.v then supplies
# real models and `prep -flatten` absorbs them, leaving 3 modules. On the gold
# side nothing instantiates them, `opt_clean` does not remove blackboxes, and
# 431 modules survive -- which is the "Unmatched module exists in gold that does
# not exist in gate" error that stopped the comparison.
#
# Counted from the failing run: gold 431 modules, gate 3, and every one of the
# 428 extra was a sky130_fd_sc_hd cell, not design logic.
#
# The gate side names no file: @PDK_FORMAL@ and @NETLIST@ are filled in by the
# Yosys.EQY step with this run's formal PDK models and netlist. The script
# used to hard-code runs/ch4kb/294-openroad-fillinsertion/soc_asic_top.nl.v,
# so every EQY attempt compared the RTL with an older run's netlist.
#
# The liberty read therefore belongs to [gate] only. The two SRAM macro models
# stay shared, because the RTL really does instantiate those.

[script]
verilog_defines -DPDK_sky130A
verilog_defines -DSCL_sky130_fd_sc_hd
verilog_defines -D__openlane__
verilog_defines -D__pnr__
read_verilog -sv -lib  /mnt/e/Projects/RISCV-research/asic/soc_dm_4kb/macros/verilog/sky130_sram_2kbyte_1rw1r_32x512_8.v
read_verilog -sv -lib  /mnt/e/Projects/RISCV-research/asic/soc_dm_4kb/macros/verilog/sky130_sram_1kbyte_1rw1r_32x256_8.v

blackbox

[gold]
read_verilog -formal -sv /mnt/e/Projects/RISCV-research/hdl/alu.v /mnt/e/Projects/RISCV-research/hdl/aludec.v /mnt/e/Projects/RISCV-research/hdl/branch.v /mnt/e/Projects/RISCV-research/hdl/predictor/bht_2bit.v /mnt/e/Projects/RISCV-research/hdl/controller.v /mnt/e/Projects/RISCV-research/hdl/datapath.v /mnt/e/Projects/RISCV-research/hdl/extend.v /mnt/e/Projects/RISCV-research/hdl/hazard_unit.v /mnt/e/Projects/RISCV-research/hdl/maindec.v /mnt/e/Projects/RISCV-research/hdl/regfile.v /mnt/e/Projects/RISCV-research/hdl/riscv_core.v /mnt/e/Projects/RISCV-research/hdl/riscv_core_native.v /mnt/e/Projects/RISCV-research/hdl/cache/icache_tag_ram.v /mnt/e/Projects/RISCV-research/hdl/cache/icache_controller.v /mnt/e/Projects/RISCV-research/hdl/cache/cache_dse_data_bank.v /mnt/e/Projects/RISCV-research/hdl/cache/icache_dse_core.v /mnt/e/Projects/RISCV-research/hdl/cache/icache.v /mnt/e/Projects/RISCV-research/hdl/cache/dcache_tag_ram.v /mnt/e/Projects/RISCV-research/hdl/cache/dcache_controller.v /mnt/e/Projects/RISCV-research/hdl/cache/dcache_dse_core.v /mnt/e/Projects/RISCV-research/hdl/cache/dcache.v /mnt/e/Projects/RISCV-research/hdl/axi/cache_axi_master.v /mnt/e/Projects/RISCV-research/asic/soc_dm_4kb/axi_ram_32_asic_macro.v /mnt/e/Projects/RISCV-research/hdl/axi/native_axi_lite_master.v /mnt/e/Projects/RISCV-research/hdl/axi/axi_lite_to_apb.v /mnt/e/Projects/RISCV-research/hdl/bus/soc_address_decoder.v /mnt/e/Projects/RISCV-research/hdl/perf_counters.v /mnt/e/Projects/RISCV-research/hdl/apb_performance_monitor.v /mnt/e/Projects/RISCV-research/hdl/performance_observability.v /mnt/e/Projects/RISCV-research/hdl/apb_timer.v /mnt/e/Projects/RISCV-research/hdl/apb_display_regs.v /mnt/e/Projects/RISCV-research/hdl/hex7seg_decoder.v /mnt/e/Projects/RISCV-research/hdl/lcd_1602_hex.v /mnt/e/Projects/RISCV-research/hdl/fifo.sv /mnt/e/Projects/RISCV-research/hdl/baudrate_gen_block.sv /mnt/e/Projects/RISCV-research/hdl/rx_block.sv /mnt/e/Projects/RISCV-research/hdl/tx_block.sv /mnt/e/Projects/RISCV-research/hdl/uart_core.sv /mnt/e/Projects/RISCV-research/hdl/uart_apb.v /mnt/e/Projects/RISCV-research/asic/soc_dm_4kb/cache_data_ram_sram4.v /mnt/e/Projects/RISCV-research/hdl/soc_top.v /mnt/e/Projects/RISCV-research/asic/soc_dm_4kb/soc_asic_top.v

[gate]
read_liberty -lib -ignore_miss_dir -setattr blackbox /home/toanl/.volare/volare/sky130/versions/0fe599b2afb6708d281543108caf8310912f54af/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_025C_1v80.lib
read_verilog -formal -sv @PDK_FORMAL@ @NETLIST@

[script]
hierarchy -top soc_asic_top
proc
prep -top soc_asic_top -flatten

memory -nomap
async2sync

[strategy sat]
use sat
depth 5

[strategy pdr]
use sby
engine abc pdr -rfi
