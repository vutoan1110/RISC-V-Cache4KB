# Existing APB peripherals and board display logic.
set_global_assignment -name VERILOG_FILE hdl/apb_display_regs.v
set_global_assignment -name VERILOG_FILE hdl/apb_timer.v
set_global_assignment -name VERILOG_FILE hdl/perf_counters.v
set_global_assignment -name VERILOG_FILE hdl/apb_performance_monitor.v
set_global_assignment -name VERILOG_FILE hdl/performance_observability.v
set_global_assignment -name VERILOG_FILE hdl/hex7seg_decoder.v
set_global_assignment -name VERILOG_FILE hdl/lcd_1602_hex.v
set_global_assignment -name SYSTEMVERILOG_FILE hdl/fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE hdl/baudrate_gen_block.sv
set_global_assignment -name SYSTEMVERILOG_FILE hdl/rx_block.sv
