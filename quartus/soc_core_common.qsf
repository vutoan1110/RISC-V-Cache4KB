set_global_assignment -name SEARCH_PATH hdl
set_global_assignment -name HEX_FILE hdl/riscv_full.hex
set_global_assignment -name MIF_FILE hdl/riscv_full_byte0.mif
set_global_assignment -name MIF_FILE hdl/riscv_full_byte1.mif
set_global_assignment -name MIF_FILE hdl/riscv_full_byte2.mif
set_global_assignment -name MIF_FILE hdl/riscv_full_byte3.mif

# This snapshot intentionally does not invent pin assignments. Copy the proven
# DE2-115 pin/I/O-standard assignments from the user's board project before
# programming hardware. The active timing constraint is the 50 MHz SDC above.
